var #result = 0;
var $result = 0;

mcfun fib(n) {
    if (n <= 1) {
        return n;
    } else {
        return fib(n - 1) + fib(n - 2);
    }
}

// `n` is in a temp while the recursive call runs, so the call needs a stack frame.
mcfun fact(n) {
    if (n <= 1) { return 1; }
    return n * fact(n - 1);
}

mcfun test() {
    #result = fib(10);
    $result = #result;
    /say fib(10) = {{$result}};

    #result = fact(5);
    $result = #result;
    /say fact(5) = {{$result}};
}
