import "std";

var #x = 0;
var #loaded = 0;
var #i = 0;
var #sum = 0;
var $item = "stone";
var $count = 0;
var $tag = "poplar_e2e";
var $copy = 0;
var $ratio = 0 as float;
var $stats = {hp: 0, name: "Steve"};
var $pos = [0, 0];
var $names = [];
var $flag = true;
var $src = {};
var $sid = "minecraft:diamond";

mcfun show(label, value) {
    /say {{label}} = {{value}};
}

// No chunk stays loaded without a player, and `forceload` loads it only on a later tick.
mcfun load() {
    #loaded = 1;
    /forceload add 0 0;
}

mcfun grade(score) {
    if (score >= 90) { return 1; } else if (score >= 50) { return 2; } else { return 3; }
}

// A data variable and a parameter in one command.
mcfun labelItem(n) {
    /say {{$item}} x{{n}};
}

// A data insert in execute, in an mcfun with a parameter.
mcfun markVia(v) {
    execute (as @e[tag={{$tag}}]) { @s.$data.param = v as int; }
}

// 1 + 3 + 5 + 7 + 9: `while (true)` with `break` and `continue`.
mcfun oddSum() {
    #i = 0;
    #sum = 0;
    while (true) {
        #i = #i + 1;
        if (#i > 9) { break; }
        if (#i % 2 == 0) { continue; }
        #sum = #sum + #i;
    }
}

// `return` from inside a loop, in an mcfun with a parameter.
mcfun firstSquareOver(limit) {
    #i = 1;
    while (#i < 100) {
        if (#i * #i > limit) { return #i; }
        #i = #i + 1;
    }
    return -1;
}

// `return` from inside `execute (...)`: the first entity that matches.
mcfun anyStrong() {
    execute (as @e[tag=poplar_e2e]) {
        if (@s.#x > 5) { return 1; }
    }
    return 0;
}

// The optimizer cannot know the value of a call, so the math below runs in the game.
mcfun three() {
    return 3;
}

mcfun test() {
    show("loaded", #loaded);

    #x = three();
    #x = (#x + 4) * 2 - #x % 2;
    show("math", #x);

    #x = 10 - #x;
    show("temp", #x);

    show("grade", grade(95) * 100 + grade(60) * 10 + grade(10));

    if (#x < 0 and !(#x == -5)) { show("logic", 1); } else { show("logic", 0); }

    #x = 0;
    while (#x < 5) { #x = #x + 1; }
    show("while", #x);

    $count = #x * 2;
    #x = $count + 1;
    show("data", #x);
    #x = $count * 100;
    show("scaled", #x);
    /say item {{$item}};
    show("quote", "a \"b\" \\ c");
    // `for` runs when the pack is built: 1 + 2 + 3 + 4.
    var total = 0;
    for (1..5) |i| { total = total + i; }
    show("for", total);
    labelItem(3);

    #x = 4;
    $ratio = #x * 5 as float;
    #x = $ratio * 10;
    show("typed", #x);
    $stats.hp = #x / 10;
    #x = $stats.hp;
    show("path", #x);
    $pos = [#x, 7];
    #x = $pos[1];
    show("literal", #x);
    append($names, "Ann");
    append($names, $stats.name);
    #x = len($names);
    show("len", #x);
    /say insert {{#x}} double {{#x * 2}};
    /say second {{$names[1]}};
    if ($stats.name == "Steve" and $flag == true) { /say condition ok; }
    $flag = false;
    if ($flag == false) { /say flag off; }
    // A bare path is Minecraft's `if data`: the path exists, whatever its value.
    if ($flag) { /say flag exists; }
    if (!$stats.bonus) { /say no bonus; }
    oddSum();
    show("odd sum", #sum);
    show("square", firstSquareOver(50));
    show("abs", abs(-5));
    show("clamp", clamp(30, 0, 20));
    show("sqrt", sqrt(50));
    show("pow", pow(2, 10));
    show("random", random(5, 5));
    #x = random(10, 20);
    if (#x >= 10 and #x <= 20) { /say random in range; }
    show("minmax", min(3, max(1, 2)));

    /summon marker 0 0 0 {Tags:["poplar_e2e"]};
    execute (as @e[type=marker,tag=poplar_e2e]) {
        @s.#x = 7;
        @s.#x = @s.#x * 3;
    }
    #x = @e[type=marker,tag=poplar_e2e,limit=1].#x;
    show("entity", #x);
    show("strong", anyStrong());

    @n[tag=poplar_e2e].$data.hp = 7;
    #x = @n[tag=poplar_e2e].$data.hp;
    show("nbt", #x);
    @n[tag=poplar_e2e].$data.f = #x as float;
    #x = @n[tag=poplar_e2e].$data.f * 10;
    show("nbt scaled", #x);
    $copy = @n[tag=poplar_e2e].$data.hp;
    /say copy {{$copy}};
    /say marker {{@n[tag=poplar_e2e].$data.hp}};
    execute (as @e[tag={{$tag}}]) { @s.$data.via = 5; }
    #x = @n[tag=poplar_e2e].$data.via;
    show("via", #x);
    markVia(9);
    #x = @n[tag=poplar_e2e].$data.param;
    show("param via", #x);
    /kill @e[type=marker,tag=poplar_e2e];

    var #count = 0;
    var $words = [];
    while (#count < 3) {
        #count = #count + 1;
        append($words, "w");
    }
    #x = #count + len($words);
    show("locals", #x);
    #x = sumDown(4);
    show("local recursion", #x);
    $src = {x: 1};
    copyLocal();
    $src = {};
    copyLocal();

    var $short = slice($sid, 10);
    /say slice {{$short}};
    /say end {{slice($sid, -3)}};
    #x = 42;
    var $text = str(#x);
    /say str {{$text}};
    /say nested {{slice(str(#x * 3), 1)}};
    if (startsWith($sid, "minecraft:")) { /say starts; }
    if (endsWith($sid, "stone")) { /say wrong suffix; }
    var $tiny = "x";
    if (!startsWith($tiny, "minecraft:")) { /say short ok; }
}

// A failed copy must not leave the value of an earlier call: locals are removed when the mcfun ends.
mcfun copyLocal() {
    var $picked = $src.x;
    if ($picked) { /say copy present; } else { /say copy absent; }
}

// Each call has its own #here, so the recursive call must not change it.
mcfun sumDown(n) {
    var #here = n;
    if (n <= 0) { return 0; }
    var #rest = sumDown(n - 1);
    return #here * 10 + #rest;
}
