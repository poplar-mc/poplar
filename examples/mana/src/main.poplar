// Every player has mana that regenerates each tick. `/trigger cast` spends 30 of it on a speed boost.
namespace mana;

import std;

var #mana = 0;
var #maxMana = 100;

mcfun load() {
    onTrigger("cast", cast);
}

mcfun tick() {
    execute (as @a) {
        regen();
    }
}

// Runs as each player. `@s.#mana` is the player's own mana.
mcfun regen() {
    if (@s.#mana < #maxMana) {
        @s.#mana = @s.#mana + 1;
    }
    std:actionBar(@s, ["Mana: ", text(@s.#mana), "/", text(#maxMana)]);
}

mcfun cast() {
    if (@s.#mana < 30) {
        std:tellraw(@s, {text: "Not enough mana", color: "red"});
        return;
    }
    @s.#mana = @s.#mana - 30;
    /effect give @s speed 5 1;
    std:tellraw(@s, {text: "Whoosh!", color: "aqua"});
}
