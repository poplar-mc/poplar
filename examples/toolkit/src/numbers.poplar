// `/trigger fib` prints the first Fibonacci numbers. `fib` calls itself; Poplar saves what each call needs.
namespace toolkit;

import std;

mcfun fib(n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

mcfun showFibonacci() {
    var #i = 0;
    while (#i <= 10) {
        var #value = fib(#i);
        std:tellraw(@s, ["fib(", text(#i), ") = ", text(#value)]);
        #i = #i + 1;
    }
}
