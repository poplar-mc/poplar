// Counts deaths for each player and for the whole server, with a random message.
import "std";

var #deaths = 0;
var #worst = 0;

mcfun load() {
    onEvent("deathCount", playerDied);
}

// Runs as the player who died, once per death.
mcfun playerDied() {
    #deaths = #deaths + 1;
    @s.#deaths = @s.#deaths + 1;
    #worst = max(#worst, @s.#deaths);

    var #message = random(1, 3);
    if (#message == 1) {
        tellraw(@a, [{selector: "@s"}, " tripped."]);
    } else if (#message == 2) {
        tellraw(@a, [{selector: "@s"}, " forgot to eat."]);
    } else {
        tellraw(@a, [{selector: "@s"}, " met their end."]);
    }

    // A subtitle shows with the next title, so it comes first.
    subtitle(@s, ["Deaths: ", text(@s.#deaths)]);
    title(@s, {text: "You died", color: "red"});
    actionBar(@a, ["Server deaths: ", text(#deaths), ", the most by one player: ", text(#worst)]);
}
